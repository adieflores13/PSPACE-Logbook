# Flask PSPACE origin, without /api/mobile/v1. This is public app configuration.
# iOS simulator: http://127.0.0.1:8000
# Android emulator: http://10.0.2.2:8000
# Physical device: http://YOUR_COMPUTER_LAN_IP:8000 (Flask must listen on 0.0.0.0)
# Production must use HTTPS.
EXPO_PUBLIC_PSPACE_URL=http://127.0.0.1:8000
